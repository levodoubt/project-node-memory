{
  "name": "project-node-memory",
  "version": "1.5.14",
  "description": "Project node knowledge base for DSH agents: markdown-as-database, stable TIDs, transclusion projection, structure self-check.",
  "type": "module",
  "bin": {
    "nodekb": "./bin/nodekb.mjs"
  },
  "license": "MIT",
  "author": "levodoubt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/levodoubt/project-node-memory.git"
  },
  "homepage": "https://github.com/levodoubt/project-node-memory#readme",
  "bugs": {
    "url": "https://github.com/levodoubt/project-node-memory/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh-plugin",
    "knowledge-base",
    "markdown",
    "context",
    "project-memory"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./engine": {
      "default": "./lib/engine/mdlib.js"
    },
    "./engine/*": "./lib/engine/*",
    "./cli": {
      "default": "./lib/cli.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "README_EN.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test test/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.5-rc.1"
    }
  }
}
